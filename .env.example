# Copy to .env and fill in values. Never commit .env.
# Both apps read this one file: the API from the repo root, the web app via Vite's envDir.

# ---------- API ----------
# local | staging | production
ENVIRONMENT=
# Postgres connection string (psycopg 3), e.g. postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=
# Optional: database for pytest. Defaults to the local Docker `pacifyco_test` database
TEST_DATABASE_URL=
SUPABASE_URL=
# Use whichever the Supabase project uses for JWT verification
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Sender address for outgoing email
EMAIL_FROM=
# Comma-separated addresses that receive incident and payout alerts
ADMIN_ALERT_EMAILS=
# Service account key JSON (single line) for creating interview events
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
SENTRY_DSN=
# Shared secret required by /internal/jobs/* endpoints
JOBS_SECRET=
# Base URL of the web app, used in emails and links
PUBLIC_WEB_URL=
# Comma-separated allowed web origins
CORS_ORIGINS=
# UPI ID parents pay into during beta
PACIFY_UPI_ID=

# ---------- Web (exposed to the browser: no secrets here) ----------
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=
# local | staging | production
VITE_ENVIRONMENT=
