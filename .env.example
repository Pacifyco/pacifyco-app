# Copy to .env and fill in values. Never commit .env.
# Both apps read this one file: the API from the repo root, the web app via Vite's envDir.

# ---------- API ----------
# local | staging | production
ENVIRONMENT=
# The API's connection string (the pacifyco_api role when deployed). postgresql:// URLs from
# Supabase work as-is. Blank locally: uses the Docker database
DATABASE_URL=
# Deployed databases only (CI sets it): the owner role that runs migrations. Blank locally
MIGRATION_DATABASE_URL=
# Optional: database for pytest. Defaults to the local Docker `pacifyco_test` database
TEST_DATABASE_URL=
# Project URL, e.g. https://<ref>.supabase.co. The API checks sign-in tokens against its public keys
SUPABASE_URL=
# Optional: defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Sender address for outgoing email
EMAIL_FROM=
# Comma-separated addresses that receive incident and payout alerts
ADMIN_ALERT_EMAILS=
# Service account key JSON (single line) for creating interview events
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
SENTRY_DSN=
# Shared secret required by /internal/jobs/* endpoints
JOBS_SECRET=
# Base URL of the web app, used in emails and links
PUBLIC_WEB_URL=
# Comma-separated allowed web origins
CORS_ORIGINS=
# UPI ID parents pay into during beta
PACIFY_UPI_ID=

# ---------- Web (exposed to the browser: no secrets here) ----------
VITE_API_URL=
VITE_SUPABASE_URL=
# The project's publishable key (sb_publishable_...). Public by design
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=
# local | staging | production
VITE_ENVIRONMENT=
# Sitter Terms placeholders (public). Blank outside production shows TEST markers; production hides
# the Sitter Terms until every one is set
VITE_PACIFY_LLPIN=
VITE_PACIFY_REGISTERED_ADDRESS=
VITE_GRIEVANCE_OFFICER_NAME=
VITE_GRIEVANCE_OFFICER_EMAIL=
VITE_GRIEVANCE_OFFICER_PHONE=
VITE_EMERGENCY_LINE=
# yyyy-mm-dd: when this version of the Sitter Terms takes effect
VITE_SITTER_TERMS_DATE=
